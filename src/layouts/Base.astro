---
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/600.css';
import '@fontsource/instrument-sans/700.css';
import '../styles/global.css';
import { siteUrl, siteName, placeholders } from '../../site.config.mjs';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const { title, description, path, noindex = false, jsonLd = [] } = Astro.props;
const canonical = new URL(path, siteUrl).href;
const ogImage = new URL('/og-image.png', siteUrl).href;
const isHome = path === '/';
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#F1ECE1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/" aria-label="Zenlingo home"><img src="/img/zenlingo-logo.svg" width="150" height="40" alt="Zenlingo" /></a>
        <nav class="site-nav" aria-label="Main">
          <ul>
            <li><a href={isHome ? '#how-it-works' : '/#how-it-works'}>How it works</a></li>
            <li><a href={isHome ? '#plans' : '/#plans'}>Plans</a></li>
            <li><a href={isHome ? '#faq' : '/#faq'}>FAQ</a></li>
            <li><a href="/support/">Support</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <ul>
          <li><a href="/privacy/">Privacy Policy</a></li>
          <li><a href="/terms/">Terms of Use</a></li>
          <li><a href="/support/">Support</a></li>
        </ul>
        <p>© {year} Zenlingo. {placeholders.legalEntity}</p>
      </div>
    </footer>
  </body>
</html>
